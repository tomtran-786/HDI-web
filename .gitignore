# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. `.env*` was swallowing it, so the one file that
# documents every variable this app needs could never reach a fresh clone.
# It holds placeholders only — real values live in .env.local and Vercel.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# crawl output + its 700MB venv — research input, not part of the app
/reference

# prisma client is generated at install time (postinstall)
/lib/generated

# real course data carries the Zoom link and Drive folder id
/prisma/courses.json
# Legacy private seed; keep ignored so the migration never exposes old links.
/prisma/cohorts.json
# Legacy private folder mapping is no longer read, but keep it ignored so an
# existing deployment cannot accidentally commit historical Drive IDs.
/prisma/drive-folders.json

# local MCP server config and installed agent skills
.mcp.json
.agents/
# .claude/skills/* are symlinks into .agents/ — committing them would give
# every other clone a dangling link. skills-lock.json is the manifest that
# lets the skills be reinstalled, and that one IS committed.
.claude/skills/
