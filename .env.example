# Copy to .env.local and fill in. .env* is gitignored — this repo is public.

# ---- Supabase Postgres ----
# App runtime: TRANSACTION-mode pooler, port 6543. Using 5432 here drains the
# pool on Vercel and takes the whole app down — see lib/prisma.ts.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres"
# Prisma CLI / migrations: SESSION-mode pooler, port 5432.
DIRECT_DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
# Percent-encode special characters in the password: @ -> %40, # -> %23, : -> %3A

# Optional: disposable Supabase/Postgres database used only by
# `npm run test:integration`. The runner refuses DATABASE_URL and also requires
# HDI_TEST_DATABASE_CONFIRM_DISPOSABLE=1 before applying migrations or writes.
# TEST_DATABASE_URL="postgresql://.../disposable_test_database"
# HDI_TEST_DATABASE_CONFIRM_DISPOSABLE="1"

# ---- Auth.js ----
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Only needed when the deployment URL cannot be inferred (e.g. custom domain).
# AUTH_URL="https://hdiresearchcenter.com"

# Canonical public origin used in verification/reset emails, PayOS callbacks and
# the page metadata (metadataBase, canonical, robots.txt, sitemap.xml). Required
# at build time in production — `next build` fails loudly rather than baking
# localhost into the canonical tags. Production value: https://hdiresearchcenter.com
APP_URL="http://localhost:3000"

# ---- Transactional email (Resend) ----
RESEND_API_KEY=""
EMAIL_FROM="HDI Research Center <no-reply@hdiresearchcenter.com>"

# ---- PayOS ----
# Use an HDI-owned merchant channel; never reuse another project's legal entity.
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

# ---- Google Drive service account ----
# Share each course folder with this service account as Content manager/Editor.
GOOGLE_CLIENT_EMAIL=""
# Vercel can store literal \\n sequences; the app normalizes them at runtime.
GOOGLE_PRIVATE_KEY=""

# ---- Admin ----
# Comma-separated email allowlist. These accounts can reach /quan-tri.
ADMIN_EMAILS="admin@example.com"

# ---- Cron ----
# Bearer token Vercel Cron sends to /api/cron/don-hang-het-han. The bounded
# housekeeping pass reconciles expired orders, Drive grants/revokes and auth
# cleanup. Purchase-time reconciliation enforces seat correctness independently.
# openssl rand -hex 32
CRON_SECRET=""
